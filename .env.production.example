NEXT_PUBLIC_API_URL=https://api.lexflow.example
NEXT_PUBLIC_APP_ENV=production
APP_ENV=production
RELEASE_PHASE=P24
RELEASE_NAME=CLOUD-DEPLOY-PACK
RELEASE_REVISION=
REQUIRE_PRODUCTION_READY=true
SEED_DEMO_ON_STARTUP=false
LEXFLOW_WEB_URL=https://app.lexflow.example
LEXFLOW_ADMIN_URL=https://admin.lexflow.example
DATABASE_URL=postgresql+psycopg://lexflow:${POSTGRES_PASSWORD}@postgres:5432/lexflow
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=https://s3.lexflow.example
S3_ACCESS_KEY=replace-with-production-access-key
S3_SECRET_KEY=replace-with-strong-production-secret-at-least-32-chars
S3_BUCKET=lexflow-production
STORAGE_PUBLIC_BASE_URL=https://api.lexflow.example/api/v1/storage
STORAGE_SIGNED_URL_MINUTES=10
MAX_UPLOAD_BYTES=26214400
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/var/lib/lexflow/storage
REQUIRE_VERIFIED_DOCUMENT_DOWNLOADS=false
MALWARE_SCANNER_PROVIDER=mock
OPENAI_API_KEY=replace-when-real-ai-is-enabled
WHATSAPP_BUSINESS_TOKEN=replace-when-real-whatsapp-is-enabled
BILLING_PROVIDER_SECRET=replace-when-real-billing-is-enabled
EMAIL_PROVIDER=http_json
EMAIL_API_URL=https://email-provider.example/send
EMAIL_API_KEY=replace-with-email-provider-api-key-at-least-20-chars
EMAIL_FROM=no-reply@lexflow.example
CREDENTIAL_ENCRYPTION_KEY=replace-with-strong-dedicated-credential-encryption-key
JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars
INITIAL_OWNER_EMAIL=owner@lexflow.example
INITIAL_OWNER_NAME=LEXFLOW Owner
INITIAL_OWNER_PASSWORD=replace-with-strong-owner-password-at-least-14-chars
INITIAL_OWNER_ROLE=owner_admin
INITIAL_OWNER_ROTATE_PASSWORD=false
REQUIRE_OWNER_MFA=false
ALLOWED_ORIGINS=https://app.lexflow.example,https://admin.lexflow.example
RATE_LIMIT_PER_MINUTE=120
FAILED_LOGIN_BACKEND=redis
FAILED_LOGIN_LIMIT=10
FAILED_LOGIN_WINDOW_MINUTES=15
MAX_UPLOAD_FILENAME_LENGTH=180
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document
LOG_LEVEL=info
POSTGRES_PASSWORD=replace-with-strong-postgres-password
MINIO_ROOT_USER=replace-with-production-minio-user
MINIO_ROOT_PASSWORD=replace-with-strong-production-minio-password
